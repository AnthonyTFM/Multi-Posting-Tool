# ---------- Required in production ----------
PUBLIC_BASE_URL=https://omuriceramen.com      # public https URL (used in texts + Twilio signature checks)
ADMIN_PASSWORD=                               # staff dashboard password (/admin)
SESSION_SECRET=                               # long random string: openssl rand -hex 32
DATABASE_PATH=/data/omurice.db                # put on a persistent disk/volume and back it up
# MEDIA_DIR=/data/media                       # uploaded photos/videos (default: next to the database)

# ---------- AI chat + phone host ----------
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5                    # default. claude-haiku-4-5 = faster/cheaper phone replies

# ---------- Google reviews on the home page ----------
GOOGLE_MAPS_API_KEY=                          # Google Cloud key restricted to "Places API (New)"
# GOOGLE_PLACE_ID=                            # optional; looked up automatically from name + address
# GOOGLE_REVIEWS_MIN_RATING=4                 # carousel shows reviews at or above this; true average always shown
# GOOGLE_REVIEWS_TTL_MIN=60                   # how often to refresh from Google

# ---------- Twilio: phone + text messages ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=                              # Twilio number for order texts (needs A2P 10DLC registration)
STAFF_TRANSFER_NUMBER=                        # 2nd store line, E.164 e.g. +12695551234. Must NOT forward to Twilio.
# STAFF_RING_SECONDS=25                       # then the caller returns to the AI
# VOICE_TTS_PROVIDER=ElevenLabs               # optional ConversationRelay voice settings
# VOICE_NAME=

# ---------- Honor POS sync (phase 2) ----------
POS_PROVIDER=none                             # none | deliverect | webhook
# DELIVERECT_API_BASE=https://api.deliverect.com
# DELIVERECT_CLIENT_ID=
# DELIVERECT_CLIENT_SECRET=
# DELIVERECT_CHANNEL_NAME=
# DELIVERECT_CHANNEL_LINK_ID=
# DELIVERECT_PAYMENT_TYPE=1                   # confirm "pay at pickup" type with Deliverect
# POS_WEBHOOK_URL=
# POS_WEBHOOK_SECRET=
